<Window x:Class="PS3DiscordRichPresence.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS3 Discord Rich Presence" Width="480" SizeToContent="Height"
        MinWidth="300" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock x:Name="StatusMessage" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Content="Close" Click="CloseClick" Padding="14,4"
                    Margin="0,0,8,0" Visibility="Collapsed" />
            <Button x:Name="ExitButton" Content="Exit" Padding="14,4" />
        </StackPanel>
    </StackPanel>
</Window>
